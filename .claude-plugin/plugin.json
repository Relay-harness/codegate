{
  "name": "codegate",
  "displayName": "CodeGate",
  "version": "0.1.1",
  "description": "Run your project's own tests, lint and type checks before Claude commits, pushes or opens a PR. Opt in per repository with codegate.toml.",
  "author": { "name": "CodeGate contributors", "url": "https://github.com/Relay-harness/codegate" },
  "homepage": "https://relay-harness.github.io/codegate/",
  "repository": "https://github.com/Relay-harness/codegate",
  "license": "MIT",
  "keywords": ["quality-gate", "git-hooks", "tests", "ci", "pre-commit"],
  "mcpServers": {
    "codegate": {
      "command": "${CLAUDE_PLUGIN_ROOT}/scripts/codegate",
      "args": ["mcp"]
    }
  }
}
